# belting_erp backend sozlamalari — nusxa: cp .env.example .env.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.trycloudflare.com
# Next dev proxy va tunnel orqali keladigan HTTPS manzillar (CSRF/cookie uchun)
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com

# Ma'lumotlar bazasi: bo'sh — SQLite (demo/dev, data/db.sqlite3); prod — PostgreSQL
# DATABASE_URL=postgres://belting:PAROL@127.0.0.1:5432/belting?sslmode=prefer
DATABASE_URL=

# Celery + Redis
REDIS_URL=redis://127.0.0.1:6379/0
# 1 — Celery vazifalari darhol shu jarayonda (Redis/worker'siz sinov)
CELERY_EAGER=0

# Telegram: Mini App initData tekshiruvi, login havolasi, natijani yuborish
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# webhook (pyTelegramBotAPI): tashqi HTTPS manzil; bo'sh — webhook o'rnatilmaydi. Sir — ixtiyoriy (standart SECRET_KEY dan)
JARVIS_PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=

# LLM: claude — Claude Agent SDK (Claude Max, API kalitsiz); echo — sinov (LLM'siz)
JARVIS_LLM=claude
JARVIS_COMPANY=Belting rezina
# brauzerda kirish havolasi (manage.py login_link) — faqat dev
JARVIS_MAGIC_LOGIN=1

# Marketplace kanallari (bo'sh — kanal ulanmagan). MP_WRITE=1 — kanalga yozuvchi amallar (bekor qilish, Uzum tasdiq,
# Ozon jo'natish, WB postavka) ochiladi; 0 — faqat o'qish (sinxron, taxta, stikerlar).
WB_TOKEN=
OZON_ID=
OZON_TOKEN=
UZUM_TOKEN=
MP_WRITE=0

# TelegramCRM (Telethon): my.telegram.org → API development tools. Sessiya kaliti: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TGCRM_API_ID=
TGCRM_API_HASH=
TGCRM_SESSION_KEY=
# AI yordamchi — 1C qoldig'i: eski Jarvis bazasi (faqat o'qish), qoldiq shu soatdan eski bo'lsa AI "bor" demaydi
JARVIS_ONEC_DB_URL=
TGCRM_STOCK_MAX_AGE_H=24

# Narx siyosati — AppSheet (Accounting › Mahsulotlar › Narx siyosati). Klinli/poliklinli va tishli remen ilovalari.
APPSHEET_VBELT_APP_ID=
APPSHEET_VBELT_KEY=
APPSHEET_VBELT_TABLE=
APPSHEET_TIMING_APP_ID=
APPSHEET_TIMING_KEY=
APPSHEET_TIMING_TABLE=
APPSHEET_TIMING_TYPES=Types
